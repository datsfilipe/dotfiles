#!/usr/bin/env bash
set -euo pipefail
wallpaper=${1:?}
case "$wallpaper" in
  @wallpaperDir@/*) ;;
  *) exit 1 ;;
esac
test -f "$wallpaper"
case "$wallpaper" in
  *\"*|*$'\n'*) exit 1 ;;
esac
sed -i "s|^    wallpaper = .*|    wallpaper = \"$wallpaper\";|" @dotfiles@/vars/default.nix
exec @terminal@ -e fish -c "sudo nixos-rebuild switch --flake @dotfiles@#$(hostname); and systemctl --user daemon-reload; and systemctl --user restart wallpaper-updater.service; echo; read -P 'press enter to close'"
